#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# Plaque pre-commit hook
# Blocks commits that contain internal documents or hardcoded secrets.
#
# Installed automatically via `npm install` (prepare script sets
# core.hooksPath to .githooks/).
#
# Emergency bypass: git commit --no-verify  (document the reason in the commit)
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

ERRORS=()
STAGED=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

# ── 1. Forbidden file/directory patterns ─────────────────────────────────────
BLOCKED_PATTERNS=(
  "^CLAUDE\.md$"
  "^DESIGN_GUIDE"
  "DESIGN_SPEC"
  "INTERNAL_"
  "\.design-guide\."
  "^supabase/"
  "^e2e/"
  "^src/__tests__/"
  "^jest\.(config|setup)\."
  "^playwright\.config\."
)

for pat in "${BLOCKED_PATTERNS[@]}"; do
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    if echo "$f" | grep -qE "$pat"; then
      ERRORS+=("Internal file staged: $f — this path is gitignored for a reason")
    fi
  done <<< "$STAGED"
done

# ── 2. .env files (belt-and-suspenders over .gitignore) ─────────────────────
while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  if basename "$f" | grep -qE '^\.env(\.|$)'; then
    ERRORS+=(".env file staged: $f — must not be committed")
  fi
done <<< "$STAGED"

# ── 3. Stray scratch files in repo root ──────────────────────────────────────
while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  if echo "$f" | grep -qE '^[^/]+\.(ts|tsx|js|jsx|py|sh)$'; then
    # Allow known legitimate root-level files
    case "$f" in
      eslint.config.*|next.config.*|postcss.config.*|tailwind.config.*|tsconfig*.json|jest.config.*|playwright.config.*)
        ;;
      *)
        ERRORS+=("Unexpected root-level script staged: $f — likely a scratch/test file")
        ;;
    esac
  fi
done <<< "$STAGED"

# ── 4. Scan staged diff for hardcoded secrets ────────────────────────────────
DIFF=$(git diff --cached -U0 2>/dev/null | grep '^+' | grep -v '^+++' || true)

# Real Supabase project URL (ref is 15-25 lowercase alphanumeric chars, no < > placeholders)
if echo "$DIFF" | grep -qE 'https://[a-z0-9]{15,25}\.supabase\.co'; then
  HITS=$(echo "$DIFF" | grep -E 'https://[a-z0-9]{15,25}\.supabase\.co' | grep -v '<' || true)
  if [[ -n "$HITS" ]]; then
    ERRORS+=("Hardcoded Supabase project URL in staged diff — use a placeholder in docs")
  fi
fi

# Real Supabase JWT (anon/service key) — HMAC-SHA256 signatures are exactly 43 base64url chars
if echo "$DIFF" | grep -qE 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9\.[A-Za-z0-9_-]{100,}\.[A-Za-z0-9_-]{43}[^A-Za-z0-9_-]'; then
  ERRORS+=("Possible real Supabase JWT (anon/service key) in staged diff — store in .env.local only")
fi

# ── Report ────────────────────────────────────────────────────────────────────
if [[ ${#ERRORS[@]} -gt 0 ]]; then
  printf '\n🔴  pre-commit: commit blocked\n\n'
  for e in "${ERRORS[@]}"; do
    printf '   ✗  %s\n' "$e"
  done
  printf '\nFix the issues above, then try again.\n'
  printf 'Emergency bypass: git commit --no-verify  (document the reason)\n\n'
  exit 1
fi

exit 0
